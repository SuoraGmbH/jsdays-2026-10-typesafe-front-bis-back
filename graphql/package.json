{
  "name": "example-graphql",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate && (npm run server & npm run client)",
    "server": "tsx watch src/server/server.ts",
    "client": "vite --open",
    "generate": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-yoga": "^5.24.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
